# Copy this file to keystore.properties (gitignored) and fill in your values.
# Create a release keystore once:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Keep upload-keystore.jks and keystore.properties out of Git and backed up privately.
# Play App Signing: upload the AAB signed with this key; Google may re-sign for distribution.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
